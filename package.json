{
  "name": "photo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "dist": "vite build",
    "lint": "eslint . --cache",
    "lint:check": "eslint . --cache && prettier --check .",
    "tsc": "tsc -b",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:integration": "vitest --run src/contexts/__tests__/psd-utils.test.ts src/hooks/__tests__/useApp.psd.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "echo 'HEADED: a live window is on screen. Do not touch the mouse, keyboard or focus while it runs - your input reaches the page and shows up as a test failure. Use this to watch a visual/canvas issue, not to gate on a result.' && PLAYWRIGHT_ALLOW_HEADED=1 playwright test",
    "test:e2e:unit": "vitest --run --config vitest.e2e.config.ts",
    "test:e2e:unit:coverage": "vitest --run --coverage --config vitest.e2e.config.ts",
    "test:e2e:update-baselines": "playwright test e2e/export/visual-regression.spec.ts --update-snapshots",
    "test:e2e:report": "playwright show-report",
    "test:e2e:clean": "rm -rf test-results",
    "test:e2e:install": "playwright install chrome",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,yml,yaml,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "ag-psd": "^31.0.2",
    "classnames": "^2.5.1",
    "gifenc": "^1.0.3",
    "lodash-es": "^4.18.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "utif": "^3.1.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.5",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.2",
    "autoprefixer": "^10.6.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "lint-staged": "^17.5.1",
    "pixelmatch": "^7.2.0",
    "postcss": "^8.5.16",
    "prettier": "^3.9.7",
    "sass-embedded": "^1.97.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.1.3",
    "vitest": "^5.0.1",
    "zod-validation-error": "^5.0.0"
  }
}
