{
  "name": "photo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build --logLevel silent",
    "dist": "vite build",
    "swarm": "node scripts/agent-board.mjs",
    "repo:state": "node scripts/repo-state-gate.mjs",
    "branches:orphan": "node scripts/orphan-branches.mjs",
    "swarm:release-merged": "node scripts/merge-release.mjs",
    "dispose": "node scripts/dispose-worktree.mjs",
    "session:id": "node scripts/find-session-id.mjs",
    "docs:tools": "node scripts/generate-tool-docs.mjs",
    "lint": "node scripts/lint-tracked.js --eslint-only",
    "lint:check": "node scripts/lint-tracked.js",
    "tsc": "tsc -b",
    "lint:fix": "node scripts/lint-tracked.js --eslint-only --fix",
    "format": "node scripts/lint-tracked.js --write",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:staged": "git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 vitest related --run",
    "test:integration": "vitest --run src/contexts/__tests__/psd-utils.test.ts src/hooks/__tests__/useApp.psd.test.ts",
    "test:e2e": "node scripts/e2e-run.mjs",
    "test:e2e:raw": "playwright test",
    "test:e2e:ui": "node scripts/e2e-run.mjs --ui",
    "test:e2e:debug": "node scripts/e2e-run.mjs --debug",
    "test:e2e:headed": "echo 'HEADED: a live window is on screen. Do not touch the mouse, keyboard or focus while it runs - your input reaches the page and shows up as a test failure. Use this to watch a visual/canvas issue, not to gate on a result.' && PLAYWRIGHT_ALLOW_HEADED=1 node scripts/e2e-run.mjs",
    "test:e2e:unit": "vitest --run --config vitest.e2e.config.ts",
    "test:e2e:unit:coverage": "vitest --run --coverage --config vitest.e2e.config.ts",
    "test:e2e:update-baselines": "node scripts/e2e-run.mjs e2e/export/visual-regression.spec.ts --update-snapshots=all",
    "test:e2e:report": "playwright show-report",
    "test:e2e:clean": "rm -rf test-results/*/ test-results/.last-run.json playwright-report",
    "test:e2e:install": "playwright install chrome",
    "probe:console": "node scripts/probe-console.mjs",
    "prepare": "node scripts/install-git-hooks.js && node scripts/install-tsc-guard.mjs",
    "gate:verify": "npm run --silent tsc && npm run --silent build",
    "gate:commit": "node scripts/quiet-command.mjs lint-staged --fail-on-changes --no-stash && npm run --silent gate:verify",
    "gate:push": "node scripts/quiet-command.mjs npm run --silent test -- --silent"
  },
  "engines": {
    "node": ">=24"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,mjs,cjs,scss,css,jsonc,yml,yaml,md,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "ag-psd": "^31.0.2",
    "classnames": "^2.5.1",
    "gifenc": "^1.0.3",
    "lodash-es": "^4.18.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "utif": "^3.1.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.5",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.2",
    "autoprefixer": "^10.6.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^30.1.0",
    "lint-staged": "^17.5.1",
    "pixelmatch": "^7.2.0",
    "postcss": "^8.5.16",
    "prettier": "^3.9.7",
    "sass-embedded": "^1.97.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.1.3",
    "vitest": "^5.0.1",
    "zod-validation-error": "^5.0.0"
  }
}
