{
  "compilerOptions": {
    // Not an incremental-build optimisation: with `noEmit: true` and no `composite`,
    // `tsc -b` re-checks this project on every run and never reports it up to date.
    // What the setting actually does is redirect where `tsc -b` writes the buildinfo.
    // Without it, the default path is the repo root, and every `npm run tsc` leaves
    // an untracked `tsconfig.app.tsbuildinfo` next to this file.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client", "@testing-library/jest-dom", "vitest/globals"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path aliases */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting */
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  // `toolbar-mapping.ts` lives at the repo root, so `src` does not match it. It is
  // listed explicitly: without it the file enters this program only through the
  // imports of its consumers, and deleting the last one would drop it out of every
  // TypeScript project with no error anywhere. Moving it under `src/` is the other
  // option, but that is a wider refactor than this include deserves.
  "include": ["src", "toolbar-mapping.ts"]
}
