+test.describe('Tablet Type-tool touch re-entry', () => {
+  test.use({
+    viewport: { width: 834, height: 1194 },
+    hasTouch: true,
+    isMobile: false,
+  });
+
+  test.beforeEach(async ({ page }) => {
+    await page.goto('/', { waitUntil: 'domcontentloaded' });
+    await expect(getWorkspaceCanvas(page)).toBeVisible();
+    await page.getByTestId('right-panel-toggle').click();
+    await selectTextTool(page);
+  });
+
+  test('a single touch tap inside committed text bounds opens the editor', async ({ page }) => {
+    await setTextToolColor(page, TEXT_COLOR);
+    const box = await canvasBox(page);
+
+    await clickToPlace(page, box, FIRST_BOX_CLICK);
+    await expect(overlay(page)).toBeVisible();
+    await page.keyboard.type('Tablet touch route');
+    expect(await overlayText(page)).toBe('Tablet touch route');
+    await page.keyboard.press('Escape');
+    await expect(overlay(page)).toHaveCount(0);
+
+    // The tablet band hides the Layers panel; locate a unique committed-text pixel instead. The
+    // mouse control below must hit this same point before touchscreen input is tested.
+    const committedCanvasBox = await canvasBox(page);
+    const clip = {
+      x: committedCanvasBox.x,
+      y: committedCanvasBox.y,
+      width: committedCanvasBox.width,
+      height: committedCanvasBox.height,
+    };
+    const image = await loadImageData(await page.screenshot({ clip }));
+    let redPixelOffset = -1;
+    for (let offset = 0; offset < image.data.length; offset += 4) {
+      if (isRedInk(image.data[offset], image.data[offset + 1], image.data[offset + 2], image.data[offset + 3])) {
+        redPixelOffset = offset;
+        break;
+      }
+    }
+    expect(redPixelOffset, 'the committed text did not produce its unique red canvas ink').toBeGreaterThanOrEqual(0);
+    const pixelIndex = redPixelOffset / 4;
+    const pixelX = pixelIndex % image.width;
+    const pixelY = Math.floor(pixelIndex / image.width);
+    // Convert captured pixels back through the clip's measured scale rather than assuming DPR=1.
+    const touchPoint = {
+      x: committedCanvasBox.x + ((pixelX + 0.5) * committedCanvasBox.width) / image.width,
+      y: committedCanvasBox.y + ((pixelY + 0.5) * committedCanvasBox.height) / image.height,
+    };
+    expect(touchPoint.x).toBeGreaterThanOrEqual(committedCanvasBox.x);
+    expect(touchPoint.x).toBeLessThanOrEqual(committedCanvasBox.x + committedCanvasBox.width);
+    expect(touchPoint.y).toBeGreaterThanOrEqual(committedCanvasBox.y);
+    expect(touchPoint.y).toBeLessThanOrEqual(committedCanvasBox.y + committedCanvasBox.height);
+    await page.keyboard.press('Escape');
+    await expect(overlay(page)).toHaveCount(0);
+
+    // The mouse control verifies the derived point hits the committed layer before testing touch.
+    await page.mouse.click(touchPoint.x, touchPoint.y);
+    await expect(
+      overlay(page),
+      'the bounds-verified tablet point missed the committed text for mouse input'
+    ).toBeVisible();
+    expect(await overlayText(page)).toBe('Tablet touch route');
+    await page.keyboard.press('Escape');
+    await expect(overlay(page)).toHaveCount(0);
+
+    await page.touchscreen.tap(touchPoint.x, touchPoint.y);
+    await expect(overlay(page), 'a tablet tap inside the committed text bounds did not enter edit mode').toBeVisible();
+    await expect(overlay(page)).toBeFocused();
+    expect(await overlayText(page)).toBe('Tablet touch route');
+    expect((await selectionState(page)).inside).toBe(true);
+
+    await page.keyboard.press('ControlOrMeta+a');
+    await page.keyboard.type('Tablet touch edited');
+    expect(await overlayText(page)).toBe('Tablet touch edited');
+    await page.getByRole('button', { name: 'Commit', exact: true }).tap();
+    await expect(overlay(page)).toHaveCount(0);
+
+    await page.touchscreen.tap(touchPoint.x, touchPoint.y);
+    await expect(overlay(page)).toBeVisible();
+    expect(await overlayText(page)).toBe('Tablet touch edited');
+    await page.keyboard.press('Escape');
+  });
+});
