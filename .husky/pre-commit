#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

set -eu

echo "🔍 Running pre-commit checks..."

# Run lint:fix first to auto-fix any fixable issues
echo "  → Running eslint --fix..."
npm run lint:fix 2>&1 | tee /tmp/lint-fix.log
LINT_FIX_EXIT=${PIPESTATUS[0]}

# Check if there are any staged changes after lint:fix
if git diff --quiet; then
  echo "  ✓ No auto-fixable issues found"
else
  echo "  → Auto-fixed issues detected, re-staging..."
  git add -u
  echo "  ✓ Changes re-staged"
  echo ""
  echo "  ℹ️  Please review the changes and commit again."
  exit 1
fi

# Run lint check (with cache) and prettier check in parallel
echo "  → Running lint check + prettier..."
npm run lint:check 2>&1 | tee /tmp/lint-check.log &
LINT_PID=$!
npm run tsc 2>&1 | tee /tmp/tsc.log &
TSC_PID=$!

wait $LINT_PID; LINT_EXIT=${PIPESTATUS[0]}
wait $TSC_PID; TSC_EXIT=${PIPESTATUS[0]}

ERROR_COUNT=0

if [ $LINT_EXIT -ne 0 ]; then
  ERROR_COUNT=$((ERROR_COUNT + 1))
  echo ""
  echo "❌ Lint check failed ($LINT_EXIT)"
  echo "   Run 'npm run lint:check' to see details"
  # Count errors from output
  ERROR_LINES=$(grep -c "error" /tmp/lint-check.log 2>/dev/null || echo 0)
  WARNING_LINES=$(grep -c "warning" /tmp/lint-check.log 2>/dev/null || echo 0)
  echo "   Errors: $ERROR_LINES, Warnings: $WARNING_LINES"
fi

if [ $TSC_EXIT -ne 0 ]; then
  ERROR_COUNT=$((ERROR_COUNT + 1))
  echo ""
  echo "❌ TypeScript check failed ($TSC_EXIT)"
  echo "   Run 'npm run tsc' to see details"
fi

if [ $ERROR_COUNT -gt 0 ]; then
  echo ""
  echo "💥 $ERROR_COUNT check(s) failed. Fix the issues and try committing again."
  echo "   Tip: Run 'npm run lint:fix' to auto-fix some issues."
  exit 1
fi

echo ""
echo "✅ All pre-commit checks passed!"
exit 0