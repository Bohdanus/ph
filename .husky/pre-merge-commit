#!/usr/bin/env sh
# Direct self-committing merges are not a supported workflow. Refuse every one here,
# regardless of whether this Git version exposes MERGE_HEAD to this hook. Prepare a
# clean merge with --no-commit --no-ff so pre-commit can inspect the actual merge state.
# What this hook cannot cover:
# - Fast-forward merges do not invoke it. The non-blocking post-merge hook still runs.
# - `--no-verify` bypasses every blocking hook in this repository.
printf '%s\n' 'merge-takeover-guard: direct self-committing merges are refused; prepare with `git merge --no-commit --no-ff <full-sha>` and commit the prepared result.' >&2
exit 1
